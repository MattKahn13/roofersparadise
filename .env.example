# Copy to .env (gitignored) and fill in. Never commit real values.
DATA_DIR=./data
ENABLE_WORKERS=0
PUBLIC_BASE_URL=http://localhost:8010
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=alerts@roofersparadise.com

# --- Turso (free cloud DB) -- set these in PROD (Render + GitHub Actions secrets).
# Leave BLANK for local dev/tests: store.py falls back to a local SQLite file at DATA_DIR/app.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
